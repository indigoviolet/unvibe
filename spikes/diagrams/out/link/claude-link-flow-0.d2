direction: right

server: "Server sends folded header"
parse: "http.client parse_headers"
msg: "HTTPMessage keeps CRLF"
norm: "_normalize_header_values" {
  link: "diff:conn:89-113"
}
fold: "OWS CRLF RWS becomes one space" {
  link: "diff:conn:80-88"
}
headers: "HTTPHeaderDict r.headers"
jar: "Requests cookie jar"

server -> parse: raw bytes
parse -> msg: unfolded value retained
msg -> norm: getresponse passes message {
  link: "diff:conn:647-654"
}
norm -> fold: per value
fold -> norm: normalized value
norm -> headers: returns header items
norm -> msg: rewrites same object in place
msg -> jar: reads normalized headers