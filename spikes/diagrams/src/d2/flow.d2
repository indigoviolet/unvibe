direction: right
srv: "Server\nfolded header"
cli: "http.client\nparse_headers"
msg: "HTTPMessage\nvalue keeps CRLF"
norm: "_normalize_header_values\nOWS CRLF RWS becomes one space"
dict: "HTTPHeaderDict\nr.headers"
same: "HTTPMessage (same object)\nRequests' cookie jar"
srv -> cli -> msg -> norm
norm -> dict: new dict
norm -> same: rebuilt in place
