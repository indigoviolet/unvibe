{
  "name": "unvibe",
  "version": "0.0.10",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "description": "Reader for code changes: localhost service + installable web app (PRD §14).",
  "bin": {
    "unvibe": "./packages/service/dist/index.js"
  },
  "files": [
    "package.json",
    "packages/service/dist/**",
    "packages/web/dist/**",
    "prompts/**",
    "fixtures/urllib3-5020/**",
    "README.md"
  ],
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.89.0",
    "@agentclientprotocol/codex-acp": "2.2.2",
    "@agentclientprotocol/sdk": "1.8.0",
    "@fastify/static": "^10.1.7",
    "@fastify/websocket": "^11.0.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "fastify": "^5.2.0",
    "immer": "^11.1.21",
    "ws": "^8.22.0"
  },
  "overrides": {
    "@openai/codex-linux-x64": "file:./stubs/empty-platform",
    "@openai/codex-linux-arm64": "file:./stubs/empty-platform",
    "@openai/codex-darwin-x64": "file:./stubs/empty-platform",
    "@openai/codex-darwin-arm64": "file:./stubs/empty-platform",
    "@openai/codex-win32-x64": "file:./stubs/empty-platform",
    "@openai/codex-win32-arm64": "file:./stubs/empty-platform",
    "@anthropic-ai/claude-agent-sdk-linux-x64": "file:./stubs/empty-platform",
    "@anthropic-ai/claude-agent-sdk-linux-arm64": "file:./stubs/empty-platform",
    "@anthropic-ai/claude-agent-sdk-linux-x64-musl": "file:./stubs/empty-platform",
    "@anthropic-ai/claude-agent-sdk-linux-arm64-musl": "file:./stubs/empty-platform",
    "@anthropic-ai/claude-agent-sdk-darwin-x64": "file:./stubs/empty-platform",
    "@anthropic-ai/claude-agent-sdk-darwin-arm64": "file:./stubs/empty-platform",
    "@anthropic-ai/claude-agent-sdk-win32-x64": "file:./stubs/empty-platform",
    "@anthropic-ai/claude-agent-sdk-win32-arm64": "file:./stubs/empty-platform"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check": "npm run lint && npm run typecheck --workspaces --if-present && npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.14.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.12.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=24"
  }
}
