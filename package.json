{
  "name": "unvibe",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check": "npm run lint && npm run typecheck --workspaces --if-present && npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "eslint": "^9.14.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.12.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=24"
  }
}
