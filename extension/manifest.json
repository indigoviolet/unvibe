{
  "manifest_version": 3,
  "name": "Unvibe",
  "version": "0.2.0-spike",
  "description": "Review GitHub pull requests in your local Unvibe service, and ask about any GitHub page from the side panel (spike).",
  "key": "",
  "permissions": ["cookies", "sidePanel", "activeTab", "tabs"],
  "host_permissions": [
    "http://unvibe.localhost/*",
    "http://127.0.0.1/*",
    "https://github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel/panel.html"
  },
  "action": {
    "default_title": "Unvibe side panel"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*/*/pull/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://github.com/*"],
      "js": ["panel-content.js"],
      "run_at": "document_idle"
    }
  ]
}
