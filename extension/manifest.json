{
  "manifest_version": 3,
  "name": "Unvibe",
  "version": "0.1.0",
  "description": "Review GitHub pull requests in your local Unvibe service.",
  "key": "",
  "permissions": ["cookies"],
  "host_permissions": [
    "http://unvibe.localhost/*",
    "http://127.0.0.1/*",
    "https://github.com/*/*/pull/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*/*/pull/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
