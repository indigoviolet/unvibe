exports[`tool surface > is byte-stable (part of the cached L0 prefix) 1`] = `"{"common":[{"name":"get_hunk","description":"Return one diff hunk by its h: ID (h:<fileKey>:<contentHash>). Output starts with the hunk ID and file header, then the hunk text with the new-side line number on every line.","inputSchema":{"type":"object","properties":{"id":{"type":"string","description":"Hunk ID, e.g. h:conn:9f2c."}},"required":["id"],"additionalProperties":false}},{"name":"get_code","description":"Return lines of a file at a commit (default: the review head). Output starts with a code: ID, then the requested lines with line numbers. Paths must stay inside the repo; anything else is refused.","inputSchema":{"type":"object","properties":{"path":{"type":"string","description":"Repo-relative file path."},"lines":{"type":"string","description":"Line range, e.g. \\"10-20\\" or \\"10\\"."},"sha":{"type":"string","description":"Commit SHA (default: review head)."}},"required":["path","lines"],"additionalProperties":false}},{"name":"search_review","description":"Substring search over this review: guide cards, annotations, contributions, the PR description paragraphs, and changed file paths. Returns matching items with IDs (description hits are desc: IDs). A query matching a file path returns one file hit per file with its hunk IDs; map any path to all its hunk IDs with \`resolve\`. The second-opinion role searches only the description.","inputSchema":{"type":"object","properties":{"query":{"type":"string","description":"Case-insensitive substring."}},"required":["query"],"additionalProperties":false}},{"name":"resolve","description":"Map a natural-language location description (file path, line numbers, quoted code, card title, description text) to candidate IDs in this review (h:, card: and desc: IDs). The second-opinion role gets h: and desc: IDs only, never card: IDs.","inputSchema":{"type":"object","properties":{"description":{"type":"string","description":"Where the agent means."}},"required":["description"],"additionalProperties":false}}],"reader":{"name":"pin_context","description":"Pin code into the review context for later turns (reader session only). Records path, lines and why; the app refetches it when the base is built.","inputSchema":{"type":"object","properties":{"path":{"type":"string","description":"Repo-relative file path."},"lines":{"type":"string","description":"Line range, e.g. \\"10-20\\" or \\"10\\"."},"why":{"type":"string","description":"Why this code matters."}},"required":["path","lines","why"],"additionalProperties":false}}}"`;
