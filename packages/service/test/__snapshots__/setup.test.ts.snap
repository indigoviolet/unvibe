// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Linux desktop handler generation > desktop file contents 1`] = `
"[Desktop Entry]
Type=Application
Version=1.0
Name=Unvibe
Comment=Starts the Unvibe service when an unvibe:// link is opened
Exec=/usr/bin/node /usr/lib/node_modules/unvibe/dist/index.js start %u
Terminal=false
Categories=Development;
MimeType=x-scheme-handler/unvibe;
NoDisplay=true
StartupNotify=false
"
`;

exports[`Linux desktop handler generation > paths with spaces are quoted 1`] = `
"[Desktop Entry]
Type=Application
Version=1.0
Name=Unvibe
Comment=Starts the Unvibe service when an unvibe:// link is opened
Exec="/home/u/My Tools/node" "/home/u/My Tools/cli.js" start %u
Terminal=false
Categories=Development;
MimeType=x-scheme-handler/unvibe;
NoDisplay=true
StartupNotify=false
"
`;

exports[`macOS helper generation > AppleScript handles unvibe://start with absolute paths 1`] = `
"-- Unvibe link handler, generated by \`unvibe setup\`.
-- Handles unvibe://start by starting the local service.

on open location this_URL
  if this_URL starts with "unvibe://start" then
    do shell script "/opt/homebrew/bin/node /opt/homebrew/lib/node_modules/unvibe/packages/service/dist/index.js start > /dev/null 2>&1 &"
  end if
end open location

on run
  do shell script "/opt/homebrew/bin/node /opt/homebrew/lib/node_modules/unvibe/packages/service/dist/index.js start > /dev/null 2>&1 &"
end run
"
`;

exports[`macOS helper generation > Info.plist patch registers the unvibe:// scheme 1`] = `
"<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key>
  <string>com.apple.ScriptEditor.id.Unvibe-Helper</string>
  <key>CFBundleName</key>
  <string>Unvibe</string>
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>com.unvibe.helper.url</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>unvibe</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
"
`;

exports[`macOS helper generation > paths with spaces are shell-quoted inside the AppleScript string 1`] = `
"-- Unvibe link handler, generated by \`unvibe setup\`.
-- Handles unvibe://start by starting the local service.

on open location this_URL
  if this_URL starts with "unvibe://start" then
    do shell script "'/Users/test/My Tools/node' '/Users/test/My Tools/unvibe cli/dist/index.js' start > /dev/null 2>&1 &"
  end if
end open location

on run
  do shell script "'/Users/test/My Tools/node' '/Users/test/My Tools/unvibe cli/dist/index.js' start > /dev/null 2>&1 &"
end run
"
`;
