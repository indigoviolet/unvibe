exports[`start-at-login units (#108) > launchd plist runs the CLI at load, kept alive, never idle-exits 1`] = `
"<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.unvibe.service</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/node</string>
    <string>/x/cli.js</string>
    <string>start</string>
    <string>--foreground</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>UNVIBE_PORT</key>
    <string>4517</string>
    <key>UNVIBE_DATA_DIR</key>
    <string>/home/u/.local/share/unvibe</string>
    <key>UNVIBE_IDLE_MS</key>
    <string>0</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/home/u/.local/share/unvibe/unvibe-login.log</string>
  <key>StandardErrorPath</key>
  <string>/home/u/.local/share/unvibe/unvibe-login.err.log</string>
</dict>
</plist>
"
`;

exports[`start-at-login units (#108) > systemd unit starts at login, restarts, never idle-exits 1`] = `
"# Generated by \`unvibe setup\`. Re-run setup after changing the port or data dir.
[Unit]
Description=Unvibe local review service
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/node /x/cli.js start --foreground
Environment=UNVIBE_PORT=4517
Environment=UNVIBE_DATA_DIR=/home/u/.local/share/unvibe
Environment=UNVIBE_IDLE_MS=0
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
"
`;
